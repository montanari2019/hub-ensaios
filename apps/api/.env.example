NODE_ENV=development
# Nome dedicado (não "PORT") pra não colidir com o PORT que o dev server do
# apps/web às vezes exporta no mesmo ambiente quando os dois rodam juntos.
API_PORT=3001

# Postgres local via Docker Compose (ver docker-compose.yml na raiz).
# Mesmo nome que a Vercel Postgres injeta sozinha em produção quando o
# Storage é conectado ao projeto — nenhum passo manual de env var lá.
POSTGRES_URL=postgres://hub:hub@localhost:5432/hub_ensaios
POSTGRES_URL_NON_POOLING=postgres://hub:hub@localhost:5432/hub_ensaios

# Token de leitura/escrita do Vercel Blob store — use o store de
# dev/preview em desenvolvimento, nunca o de produção.
BLOB_READ_WRITE_TOKEN=

# Segredo que autoriza o endpoint interno de limpeza de staging — a Vercel
# anexa `Authorization: Bearer $CRON_SECRET` sozinha nas chamadas do Cron
# Job quando essa env var está configurada no projeto (convenção nativa,
# não um header customizado nosso).
CRON_SECRET=
