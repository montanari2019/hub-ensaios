NODE_ENV=development
# Nome dedicado (não "PORT") pra não colidir com o PORT que o dev server do
# apps/web às vezes exporta no mesmo ambiente quando os dois rodam juntos.
API_PORT=3001

# Caminho do arquivo SQLite. Default (se omitido): <raiz-do-monorepo>/hub-de-ensaios.sqlite
DB_PATH=

# Pasta onde os áudios importados são guardados. Default (se omitido): <raiz-do-monorepo>/tracks
TRACKS_DIR=
